# Generate actual random secrets with: python scripts/setup.py
ENVIRONMENT=production
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ENCRYPTION_KEY=
SECRET_KEY=
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
DATABASE_URL=postgresql+psycopg://keyacross:CHANGE_ME@127.0.0.1:55432/keyacross
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:56379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# For localhost HTTP development only. Enable for production HTTPS.
COOKIE_SECURE=false
SESSION_IDLE_SECONDS=7200
SESSION_MAX_SECONDS=86400
SYNC_INTERVAL_SECONDS=300
ALLOW_HTTP_SITES=false
ALLOWED_PRIVATE_HOSTS=
ATTACHMENT_DIR=./data/attachments
